# fastindex + LiteLLM
# Copy to .env and fill in. LiteLLM reads provider keys from the environment;
# switch providers by changing the model id (prefix), not custom code.
# Docs: https://docs.litellm.ai/

# Required for tree-reason / chat
FASTINDEX_MODEL=gpt-4o
# Optional override for tree-reason only
# FASTINDEX_TREE_REASON_MODEL=anthropic/claude-sonnet-4-5
# tree-decision uses TypeSafe Jev.
# FASTINDEX_DECISION_MODEL=typesafe/jev-latest
# TYPESAFE_API_KEY=               # required for tree-decision
# FASTINDEX_TYPESAFE_URL=https://api.typesafe.ai/v1/systemone
# FASTINDEX_DECISION_INSTRUCTIONS=Choose the source with direct evidence.
# Optional answer and judge models for `python -m evals.hybrid`
# FASTINDEX_HYBRID_MODEL=gpt-5.6-luna
# FASTINDEX_JUDGE_MODEL=gpt-5.6-luna
# Optional separate model for index preparation
# FASTINDEX_PREPARE_MODEL=anthropic/claude-sonnet-4-5

# Required for embedding baselines (vsearch, etc.)
# FASTINDEX_EMBED_MODEL=text-embedding-3-small

# Optional completion cap (default 1024)
# FASTINDEX_MAX_TOKENS=1024

# Provider API keys — set the ones that match your model id(s).
# LiteLLM picks the right key from ENV based on the model prefix.
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=
# GEMINI_API_KEY=
# GROQ_API_KEY=
# DEEPSEEK_API_KEY=
# COHERE_API_KEY=
# TOGETHER_API_KEY=
# MISTRAL_API_KEY=
# AZURE_API_KEY=
# AZURE_API_BASE=
# AZURE_API_VERSION=

# Optional OpenAI-compatible base (proxy / local gateway)
# OPENAI_BASE_URL=http://localhost:4000

# Examples (same code; only ENV changes):
#   FASTINDEX_MODEL=gpt-4o                        + OPENAI_API_KEY
#   FASTINDEX_MODEL=anthropic/claude-sonnet-4-5   + ANTHROPIC_API_KEY
#   FASTINDEX_MODEL=openrouter/openai/gpt-4o      + OPENROUTER_API_KEY
#   FASTINDEX_MODEL=ollama/llama3                 (local; no cloud key)
